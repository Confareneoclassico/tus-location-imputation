TUS_ES_data = 'restricted/hetus2010/ES.csv'
TUS_FI_data = 'restricted/hetus2010/FI.csv'
TUS_FR_data = 'restricted/hetus2010/FR.csv'
TUS_HU_data = 'restricted/hetus2010/HU.csv'
TUS_IT_data = 'restricted/hetus2010/IT.csv'
TUS_LU_data = 'restricted/hetus2010/LU.csv'
TUS_NL_data = 'restricted/hetus2010/NL.csv'
TUS_NO_data = 'restricted/hetus2010/NO.csv'
TUS_PL_data = 'restricted/hetus2010/PL.csv'
